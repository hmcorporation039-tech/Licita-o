{
  "name": "licitacao-platform",
  "version": "1.0.0",
  "description": "Plataforma de monitoramento de licitações — PNCP + ComprasNet",
  "scripts": {
    "dev:workers": "ts-node-dev --respawn --transpile-only src/workers/index.ts",
    "workers": "ts-node src/workers/index.ts",
    "dev:api": "ts-node-dev --respawn --transpile-only src/api/server.ts",
    "api": "ts-node src/api/server.ts",
    "start": "node dist/entrypoint.js",
    "start:api": "node dist/api/server.js",
    "start:workers": "node dist/workers/index.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "matches:rebuild": "ts-node scripts/rebuildMatches.ts",
    "situacoes:refresh": "ts-node scripts/refreshSituacoes.ts",
    "tenders:backfill-norm": "ts-node scripts/backfillNormColumns.ts",
    "tenders:cleanup": "ts-node scripts/cleanupOldTenders.ts",
    "documentos:check-expirations": "ts-node scripts/checkDocumentExpirations.ts",
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:e2e": "start-server-and-test api http://localhost:3333/api/health cypress:run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@google/genai": "^2.17.1",
    "@prisma/client": "^5.14.0",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "resend": "^3.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "cypress": "^13.13.0",
    "prisma": "^5.14.0",
    "start-server-and-test": "^2.0.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
