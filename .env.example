# ============================================================
# .env.example — Copie para .env e preencha os valores
# ============================================================

# PostgreSQL (Supabase)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:senha@db.xxxxx.supabase.co:5432/postgres?schema=public"

# Redis (local em dev / Upstash ou Railway Plugin em prod)
REDIS_URL="redis://localhost:6379"

# Upstash Redis (alternativa gerenciada — copie da dashboard Upstash)
# REDIS_URL="rediss://default:TOKEN@xxxxx.upstash.io:6379"

# Ambiente
NODE_ENV="development"

# Notificações por e-mail (Resend — https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="noreply@seudominio.com.br"

# Análise de editais por IA (Claude/Anthropic — https://console.anthropic.com)
ANTHROPIC_API_KEY=""
